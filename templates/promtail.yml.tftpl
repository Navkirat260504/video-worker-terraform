server:
  http_listen_port: 9080
  grpc_listen_port: 0

positions:
  filename: /tmp/positions.yaml

clients:
  - url: http://localhost:3100/loki/api/v1/push

scrape_configs:
  - job_name: video-worker
    journal:
      labels:
        job: video-worker
    relabel_configs:
      - source_labels: ['__journal__systemd_unit']
        target_label: unit
