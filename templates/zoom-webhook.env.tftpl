# Zoom webhook secret token — from Zoom Marketplace app → Feature → Webhook
ZOOM_WEBHOOK_SECRET=${zoom_webhook_secret}
ZOOM_WEBHOOK_PORT=${zoom_webhook_port}

# S3 credentials (same as video worker)
S3_ENDPOINT=${s3_endpoint}
S3_REGION=${s3_region}
S3_KEY=${s3_access_key}
S3_SECRET=${s3_secret_key}
RAW_BUCKET=${raw_bucket}
